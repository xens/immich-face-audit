# Immich base URL as reachable from this machine, e.g. http://192.168.1.10:2283
IMMICH_URL=
# Account Settings → API Keys. See README for the permissions each step needs.
IMMICH_API_KEY=
# Only for `extract --latest-backup`: admin key with maintenance + backup.download.
# It can download the whole database. Create it when needed, revoke it after.
IMMICH_BACKUP_API_KEY=
